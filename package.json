{
  "name": "bioskillshub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:browser": "node --env-file=.env scripts/rehearse-browser.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:recovery": "tsx --env-file=.env scripts/verify-recovery.ts",
    "db:setup": "tsx --env-file=.env scripts/setup.ts",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "env:check": "node --env-file=.env scripts/check-workspace.mjs",
    "db:seed-literature": "tsx --env-file=.env scripts/seed-literature.ts",
    "db:seed-rosalind": "tsx --env-file=.env scripts/seed-rosalind.ts",
    "db:seed-anthropic": "tsx --env-file=.env scripts/seed-anthropic.ts",
    "db:seed-aleksy": "tsx --env-file=.env scripts/seed-aleksy.ts",
    "test:load": "node --env-file=.env scripts/audit-load.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
